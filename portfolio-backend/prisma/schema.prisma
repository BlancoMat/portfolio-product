generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactMessage {
  id        String   @id @default(uuid())
  nombre    String
  email     String
  mensaje   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
